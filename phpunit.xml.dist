<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd" colors="true" bootstrap="tests/bootstrap.php" cacheDirectory=".phpunit.cache" failOnRisky="true" failOnWarning="true">
  <testsuites>
    <testsuite name="ByTIC Console">
      <directory suffix="Test.php">tests/src</directory>
      <exclude>tests/src/AbstractTest.php</exclude>
    </testsuite>
  </testsuites>
  <source ignoreIndirectDeprecations="true">
    <include>
      <directory suffix=".php">src</directory>
      <directory suffix=".php">bootstrap</directory>
    </include>
  </source>
</phpunit>
