{
  "name": "bytic/console",
  "description": "ByTIC Console package.",
  "type": "library",
  "keywords": [],
  "license": "MIT",
  "authors": [
    {
      "name": "Gabriel Solomon",
      "email": "hello@gabrielsolomon.ro"
    }
  ],
  "bin": [
    "bin/bytic"
  ],
  "require": {
    "php": "^8.2",
    "bytic/application": "^1.0.18",
    "bytic/config": "^2.0",
    "bytic/container": "^2.0.7",
    "bytic/dispatcher": "^2.0",
    "bytic/http": "^2.0.7",
    "bytic/router": "^2.0.1",
    "bytic/staging": "^1.0.7",
    "bytic/utility": "^1.0.92",
    "composer-runtime-api": "^2.0",
    "psr/container": "^1.1 || ^2.0",
    "symfony/console": "^6.0 || ^7.0 || ^8.0",
    "symfony/finder": "^6.0 || ^7.0 || ^8.0",
    "symfony/process": "^6.0 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "conflict": {
    "psr/http-message": "<1.1"
  },
  "autoload": {
    "psr-4": {
      "ByTIC\\Console\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ByTIC\\Console\\Tests\\": "tests/src",
      "ByTIC\\Console\\Tests\\Fixtures\\": "tests/fixtures",
      "App\\": "tests/fixtures/demoapp/application",
      "App\\Library\\": "tests/fixtures/demoapp/Library"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer fix --dry-run --diff"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
